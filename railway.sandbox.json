{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "watchPatterns": ["apps/billing-sandbox/**", "package.json", "package-lock.json", "tsconfig.base.json"]
  },
  "deploy": {
    "startCommand": "npm run start:sandbox",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 20,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
