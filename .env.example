# ---------------------------------------------------------------------------
# Proofwork local environment. Copy to `.env` at the repository root
# (apps load it through dotenv / Next's env loader) and fill placeholders.
# Generate local secrets with:  npm run secrets:generate
# Never commit real values.
# ---------------------------------------------------------------------------

# ----- Public application ---------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Comma-separated origins allowed to send cookie-authenticated writes.
PROOFWORK_ALLOWED_ORIGINS=http://localhost:3000

# ----- Supabase (local stack from `supabase start`) ------------------------
# Public values: safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-or-anon-key
# Set to "true" only after configuring Google in supabase/config.toml.
NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED=false

# ----- Database (server only) -----------------------------------------------
# Application services + worker. Uses the restricted `proofwork_app` role
# created by the migrations (set its password in scripts/roles.sql step).
DATABASE_URL=postgres://proofwork_app:replace-app-db-password@127.0.0.1:54322/postgres
# Administrative URL used ONLY by `npm run db:migrate` and seed utilities.
DATABASE_ADMIN_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres

# ----- Demo session ----------------------------------------------------------
# HMAC secret for the signed, httpOnly demo cookie (>= 32 random bytes, base64url).
DEMO_COOKIE_SECRET=replace-with-generated-secret
DEMO_SESSION_TTL_SECONDS=3600
DEMO_PURGE_AFTER_SECONDS=86400
# Enables the scenario library for private LOCAL_SANDBOX workspaces (dev only).
PROOFWORK_ENABLE_DEV_SCENARIOS=false

# ----- Independent local billing sandbox -----------------------------------
SANDBOX_PORT=4010
SANDBOX_API_URL=http://127.0.0.1:4010
# Separate database role limited to the billing_sandbox schema.
SANDBOX_DATABASE_URL=postgres://billing_sandbox_service:replace-sandbox-db-password@127.0.0.1:54322/postgres
# Bearer credentials. Read: verification. Write: recovery identity only.
# Admin: scenario setup/reset (demo + development only).
SANDBOX_READ_TOKEN=replace-with-generated-secret
SANDBOX_WRITE_TOKEN=replace-with-generated-secret
SANDBOX_ADMIN_TOKEN=replace-with-generated-secret

# ----- Stripe test mode (optional) -----------------------------------------
# Leave empty to keep the adapter "Configured: no / Connection: not checked".
# Only sk_test_ / rk_test_ keys are accepted; live keys are rejected.
STRIPE_TEST_SECRET_KEY=
STRIPE_API_VERSION=2026-08-26.dahlia
# The workspace allowed to resolve these credentials (single bound workspace).
PROOFWORK_STRIPE_WORKSPACE_ID=

# ----- Worker ---------------------------------------------------------------
WORKER_NAME=worker-local-1
WORKER_POLL_INTERVAL_MS=2000
WORKER_BATCH_SIZE=20
WORKER_CONCURRENCY=5
WORKER_LEASE_SECONDS=120

# ----- Optional AI explanation (off by default) -----------------------------
PROOFWORK_EXPLANATION_PROVIDER=none
ANTHROPIC_API_KEY=
PROOFWORK_EXPLANATION_MODEL=claude-haiku-4-5-20251001

# ----- Controllable clock (development only) --------------------------------
# Shifts "now" for web, worker and sandbox. Keep 0 outside deliberate testing.
PROOFWORK_CLOCK_OFFSET_SECONDS=0
